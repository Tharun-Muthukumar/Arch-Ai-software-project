ARCHAI_APP_NAME=ArchAI
ARCHAI_ENVIRONMENT=development
ARCHAI_DATABASE_URL=sqlite:///./archai.db
ARCHAI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000"]
ARCHAI_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
ARCHAI_OLLAMA_ENABLED=true
ARCHAI_OLLAMA_BASE_URL=http://localhost:11434
ARCHAI_OLLAMA_MODEL=qwen3:8b
ARCHAI_OLLAMA_ASSISTANT_MODEL=qwen3:8b
ARCHAI_OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
# Ollama unloads an idle model after this window. A short value makes every
# assistant turn after a pause pay a multi-second reload before inference.
ARCHAI_OLLAMA_KEEP_ALIVE=30m
ARCHAI_REQUEST_TIMEOUT_SECONDS=180
# Deadlines for the few turns that genuinely need the model. Past these the
# assistant answers from canonical evidence instead of blocking the UI.
ARCHAI_ASSISTANT_QUESTION_TIMEOUT_SECONDS=10
ARCHAI_ASSISTANT_CHANGE_TIMEOUT_SECONDS=14
ARCHAI_ASSISTANT_RISK_TIMEOUT_SECONDS=25
# Hard ceiling on a whole turn, retries and fallback included. Without it a
# retry ladder makes the worst case longer instead of more reliable.
ARCHAI_ASSISTANT_TOTAL_BUDGET_SECONDS=22
ARCHAI_ASSISTANT_RISK_BUDGET_SECONDS=40
# One controlled retry on the main model, then this smaller model, then a
# grounded deterministic answer. Leave the fallback empty to skip that step.
ARCHAI_ASSISTANT_RETRY_ONCE=true
ARCHAI_ASSISTANT_FALLBACK_MODEL=qwen3:1.7b
ARCHAI_ASSISTANT_FALLBACK_TIMEOUT_SECONDS=8
ARCHAI_AUTH_SESSION_HOURS=8
ARCHAI_LOG_LEVEL=INFO
