ARCHAI_APP_NAME=ArchAI
ARCHAI_ENVIRONMENT=development
ARCHAI_DATABASE_URL=sqlite:///./archai.db
ARCHAI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000"]
ARCHAI_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
ARCHAI_OLLAMA_ENABLED=true
ARCHAI_OLLAMA_BASE_URL=http://localhost:11434
ARCHAI_OLLAMA_MODEL=qwen3:1.7b
ARCHAI_REQUEST_TIMEOUT_SECONDS=90
ARCHAI_LOG_LEVEL=INFO
