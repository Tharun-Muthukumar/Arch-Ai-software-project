{
  "name": "archai-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup.ps1",
    "setup:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup.ps1 -BackendOnly",
    "setup:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup.ps1 -FrontendOnly",
    "dev": "concurrently --kill-others-on-fail -n backend,frontend -c green,cyan \"npm run dev:backend:reload\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010",
    "dev:backend:reload": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010 --reload",
    "dev:frontend": "npm run dev --prefix frontend -- --host 127.0.0.1 --port 5173 --strictPort",
    "serve:frontend": "python scripts/serve_frontend.py",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .venv/bin/python -m pytest",
    "test:frontend": "npm run test --prefix frontend -- --run",
    "smoke": "node scripts/smoke-test.mjs",
    "lint": "npm run lint --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
